+
+
+def warmup():
+    """预热主引擎（模型加载 + 首帧分配）。失败不抛，只返回 False。
+
+    冷启动实测 747ms、热调用 22ms，这段时间不该算在第一件商品上。
+    """
+    b = _client()
+    if b is None:
+        return False
+    fn = getattr(b, "warmup", None)
+    if fn is None:
+        return False
+    try:
+        return bool(fn())
+    except Exception:                            # noqa: BLE001
+        return False
 
 
