+    def _executor(self):
+        """惰性建线程池，并让每个 worker 先各自建好 ONNX session。"""
+        if self.parallel <= 1:
+            return None
+        if self._pool is None:
+            from concurrent.futures import ThreadPoolExecutor
+            self._pool = ThreadPoolExecutor(max_workers=self.parallel,
+                                            thread_name_prefix="scan-ocr")
+            if self._backend is None:
+                try:
+                    self._backend = ocr._client()
+                except Exception:                       # noqa: BLE001
+                    self._backend = None
+            warm = getattr(self._backend, "warmup", None)
+            if warm is not None:
+                for _ in range(self.parallel):
+                    self._pool.submit(warm)
+        return self._pool
 
