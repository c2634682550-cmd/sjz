+    def _wait_detail_ready(self, screen, cap, want=""):
+        """等详情面板**换页完成**（不是「能读到 6 位数字」）。
+
+        判据是换页证据，按顺序成立才算就绪：
+          1. 先看到「非目标态」：空帧（读完了但没有 6 位数字）；
+          2. 再看 6 位数字；给了 `want` 时必须与 `want` 逐位相同。
+
+        读失败（超预算/OCR 报错）不算「非目标态」，只当没信息 —— 否则
+        「空白 → 旧内容」会被当成换页，正好复现守门抓到的编号不一致。
+
+        没有 want 时退一步：首帧读到的 6 位数字记为「可能是上一件的」，
+        后面必须读到**不同的**数字才算换页；首帧为空的话，下一个 6 位数字
+        就算证据。
+
+        为什么不能用「读到 6 位数字」当判据：右侧详情面板会保留上一件的
+        内容直到新内容到达，旧面板的编号同样是 6 位数字。守门实测换页窗口
+        50/100/200/300ms：旧判据 10/10 次拿到的是上一件的编号，100ms 以上
+        连读钟都是旧值。换页证据在窗口里一律返回 False，窗口过去才命中，
+        所以「命中即走」的收益只在真正换完页之后兑现。
+
+        判据读走 `_read_serial_fast`：只碰一级 OCR（不触发 1.5s 探活），
+        单次有 `SERIAL_READ_CAP_S` 硬上限。整个循环的绝对上界仍是 `cap`
+        （老代码固定睡的那 0.55s）；余量不足一次判据读时，把剩余时间睡完
+        就按未命中返回 —— 调用方走老路径读钟，行为可退化，上界不延长。
+
+        无记忆：每次调用都从「首帧」重新建立证据。连开十件，每件都是新的
+        判定（旧值只活在这次调用的局部变量里）。
+        """
+        deadline = time.perf_counter() + cap
+        first = None            # 首帧读到的 6 位数字（当作「可能上一件」）
+        saw_other = False       # 是否已经看到过非目标态（空帧/读不出）
+        while True:
+            remain = deadline - time.perf_counter()
+            # 余量不够一次判据读：读了只会把上界拖长，睡完剩余时间就退化。
+            if remain <= self.SERIAL_READ_CAP_S:
+                if remain > 0:
+                    time.sleep(remain)
+                return False
+            if self._stop.is_set():
+                raise Aborted("用户停止")
+            s = self._read_serial_fast(screen)
+            if s is None:
+                # 这次没读成（超预算/OCR 报错）：既不算「看到空帧」，也不算
+                # 「读到编号」。把它当空帧，会让「空 → 旧内容」被误判成换页。
+                pass
+            elif s:
+                if want:
+                    if s == want:                   # 逐位相同 = 最强证据
+                        return True
+                elif first is None:
+                    if saw_other:                   # 空帧 → 6 位数字
+                        return True
+                    first = s                       # 首帧：先当「旧内容」
+                elif s != first:                    # 换了一行 = 换页了
+                    return True
+            else:
+                saw_other = True
+            remain = deadline - time.perf_counter()
