+
+
+def _words_fast(img, timeout=None):
+    """一级读词的**不吞异常**版；后端不是多级链时返回 None（无从快读）。"""
+    b = _client()
+    rapid = getattr(b, "rapid", None)
+    if rapid is None:
+        return None
+    if not rapid.available():               # 进程内，只查模型建没建起来
+        return []
+    return rapid.read_words(img, timeout=timeout) or []
+
+
+def read_words_fast(img, timeout=None):
+    """只要一级（进程内 RapidOCR）的词列表，**绝不碰二级探活**。
+
+    专供「几十毫秒读一次的轮询判据」（引擎里等详情面板换页）。正常路径
+    `read_words` 在一级返回空时会调 `pp.available()` —— 那是一次最长
+    1.5s 的 TCP 探活（`probe_ttl_s` 每 10 秒到期一次）。轮询里走它，550ms
+    的等待上界会被拖到 1.7s（守门实测 20 次里 2 次打到 1728/1796ms）。
+
+    这里一级为空、报错、或后端根本不是多级链，一律返回空列表：不降级、
+    不探活、不改 `last_error`、也不记 stats —— 轮询不是业务调用，记进
+    「调用/空结果」会污染自检和自动调参看的那份健康度。
+    """
+    try:
+        return _words_fast(img, timeout) or []
+    except Exception:                       # noqa: BLE001 - 判据读失败按「没读到」
+        return []
+
+
+def read_text_fast(img, timeout=None):
+    """`read_words_fast` 的整串形式，但**读失败返回 None**、图上没字返回 ""。
+
+    判据必须能区分这两件事：「这一帧是空的」算换页证据（先空后有字），
+    「这次压根没读成」只能当作没信息。把失败当空白，会让「空白 → 旧内容」
+    被误判成换页 —— 正好复现守门抓到的编号不一致。
+    """
+    try:
+        words = _words_fast(img, timeout)
+    except Exception:                       # noqa: BLE001
+        return None
+    if words is None:                       # 后端不是多级链：不支持快读
+        return None
+    return "\n".join(w["text"] for w in words)
 
 
