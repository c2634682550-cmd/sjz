diff --git a/tests/test_perf_detail_wait.py b/tests/test_perf_detail_wait.py
new file mode 100644
--- /dev/null
+++ b/tests/test_perf_detail_wait.py
@@ -0,0 +1,208 @@
+"""进详情条件等待（`_wait_detail_ready`）的换页证据、上界与可重复性。
+
+只测这五件事（不碰画面、不碰真 OCR）：
+
+1. 换页证据：必须有「先非目标态、再 6 位数字」或「读到的数字变了」才就绪；
+   首帧就是 6 位数字、之后一直不变 → 不是证据，等满 cap 返回 False
+   （宁可变慢，也不能把上一件的编号当成这一件的）。
+2. 上界：未命中耗时不超过 cap（老代码固定睡的那 0.55s），不延长。
+3. 可重复：连开十件每件都重新判定；上一件的命中不许变成下一件的「已就绪」。
+4. 停止：`_stop` 已置位时立刻抛 `Aborted`，不等不睡。
+5. 判据读不走二级探活：`core.ocr.read_words_fast` 不许调 `pp.available()`。
+"""
+
+import threading
+import time
+
+from core import ocr
+from core.engine import Aborted, Engine
+
+OLD = "001738261"          # 上一件留在面板上的编号
+NEW = "001739887"          # 本次点开那一件的编号
+
+
+class _Stub(object):
+    """只提供 `_wait_detail_ready` 真正用到的那三样：判据、停止位、读上限。"""
+
+    SERIAL_READ_CAP_S = 0.080          # 与 Engine 同值；需要时用例可改
+
+    def __init__(self, answers, read_cost=0.0):
+        self._stop = threading.Event()
+        self.answers = answers         # 常量 / 可调用(reads) -> str
+        self.reads = 0
+        self.read_cost = read_cost
+
+    def _read_serial_fast(self, screen):
+        self.reads += 1
+        if self.read_cost:
+            time.sleep(self.read_cost)
+        a = self.answers
+        return a(self.reads) if callable(a) else a
+
+
+def wait(stub, cap, want=""):
+    # 直接把方法当普通函数用：self 由这颗桩顶着，不需要实例化整个 Engine。
+    return Engine._wait_detail_ready(stub, None, cap, want)
+
+
+def test_same_serial_forever_is_not_ready():
+    # 旧判据（「读到 6 位数字就算就绪」）在这个场面上会 10/10 拿旧编号。
+    s = _Stub(OLD)
+    t0 = time.perf_counter()
+    assert wait(s, 0.20) is False, "面板内容一直没变，不能认为换完页了"
+    dt = time.perf_counter() - t0
+    assert 0.18 <= dt <= 0.30, "未命中要等满上界，实际 %.3fs" % dt
+    assert s.reads >= 2, "窗口内要继续判定，不是读一次就放弃"
+
+
+def test_old_then_new_is_ready():
+    s = _Stub(lambda n: OLD if n == 1 else NEW)
+    t0 = time.perf_counter()
+    assert wait(s, 0.55) is True
+    assert s.reads == 2, "换页证据出现在第二拍，命中即走"
+    assert time.perf_counter() - t0 < 0.10
+
+
+def test_blank_then_serial_is_ready():
+    s = _Stub(lambda n: "" if n == 1 else NEW)
+    assert wait(s, 0.55) is True
+    assert s.reads == 2
+
+
+def test_blank_then_old_serial_is_not_ready():
+    # 空帧之后又回到上一件的编号：仍然不是证据（不能把「闪了一下」当换页）
+    s = _Stub(lambda n: "" if n == 2 else OLD)
+    assert wait(s, 0.20) is False
+
+
+def test_read_failure_is_not_blank_evidence():
+    # None = 这次没读成（超预算/OCR 报错），不是「看到空帧」；
+    # 把它当空帧，就会把随后的旧内容误判成换页（守门抓到的 10/10 不一致）。
+    s = _Stub(lambda n: None if n == 1 else OLD)
+    assert wait(s, 0.20) is False
+
+
+def test_read_failure_then_digits_still_needs_change():
+    # 首帧没读成 → 后帧读到的数字仍按「可能是上一件」处理，必须再等到变化。
+    # 宁可退化成老的固定等待，也不能在没看清首帧时把旧内容当就绪。
+    s = _Stub(lambda n: None if n == 1 else NEW)
+    assert wait(s, 0.15) is False
+
+
+def test_ten_opens_each_rechecks():
+    # 连开十件：每件都是「旧 → 新」，每件都必须重新建立证据（reads 从 1 起）
+    for _ in range(10):
+        s = _Stub(lambda n: OLD if n == 1 else NEW)
+        t0 = time.perf_counter()
+        assert wait(s, 0.55) is True
+        assert s.reads == 2, "第 %d 件没有重新判定" % _
+        assert time.perf_counter() - t0 < 0.10
+
+
+def test_hit_does_not_leak_into_next_item():
+    # 上一件命中过；下一件的面板内容恰好一直不变 —— 不许沿用「已就绪」
+    s1 = _Stub(lambda n: OLD if n == 1 else NEW)
+    assert wait(s1, 0.55) is True
+    s2 = _Stub(NEW)                          # 首帧就是上一件读到的值
+    assert wait(s2, 0.15) is False, "命中不能有记忆"
+
+
+def test_want_equality_wins_immediately():
+    s = _Stub(NEW)
+    assert wait(s, 0.55, want=NEW) is True
+    assert s.reads == 1
+
+
+def test_want_mismatch_never_ready():
+    s = _Stub(OLD)
+    assert wait(s, 0.15, want=NEW) is False
+
+
+def test_miss_does_not_exceed_cap():
+    s = _Stub("", read_cost=0.050)           # 每次判据读 50ms（贴近实测）
+    t0 = time.perf_counter()
+    assert wait(s, 0.55) is False
+    dt = time.perf_counter() - t0
+    assert dt <= 0.60, "未命中不能把 550ms 上界拖长，实际 %.3fs" % dt
+    assert s.reads >= 5, "550ms 里应该读到了好几拍"
+
+
+def test_short_cap_still_bounded():
+    s = _Stub("", read_cost=0.030)
+    t0 = time.perf_counter()
+    assert wait(s, 0.20) is False
+    assert time.perf_counter() - t0 <= 0.25
+
+
+def test_stop_aborts_immediately():
+    s = _Stub(OLD)
+    s._stop.set()
+    t0 = time.perf_counter()
+    try:
+        wait(s, 0.55)
+    except Aborted:
+        pass
+    else:
+        raise AssertionError("停止位已置位时必须抛 Aborted")
+    assert time.perf_counter() - t0 < 0.05
+
+
+def test_read_words_fast_never_probes_pp(monkeypatch):
+    """轮询判据只许碰一级：二级探活一次最长 1.5s，绝不能进这个循环。"""
+
+    class _Rapid(object):
+        def __init__(self):
+            self.calls = 0
+
+        def available(self):
+            return True
+
+        def read_words(self, img, timeout=None):
+            self.calls += 1
+            return []
+
+    class _PP(object):
+        def available(self):
+            raise AssertionError("判据读不许探活二级服务")
+
+    rapid = _Rapid()
+
+    class _Backend(object):
+        def __init__(self):
+            self.rapid = rapid
+            self.pp = _PP()
+
+    monkeypatch.setattr(ocr, "_backend", _Backend())
+    assert ocr.read_words_fast(object()) == []
+    assert rapid.calls == 1
+    assert ocr.read_text_fast(object()) == ""
+    assert rapid.calls == 2
+
+
+def test_read_text_fast_reports_failure_as_none(monkeypatch):
+    """读失败必须是 None（没信息），不能伪装成 ""（空白帧）。"""
+
+    class _Rapid(object):
+        def available(self):
+            return True
+
+        def read_words(self, img, timeout=None):
+            raise RuntimeError("推理炸了")
+
+    class _Backend(object):
+        def __init__(self):
+            self.rapid = _Rapid()
+
+    monkeypatch.setattr(ocr, "_backend", _Backend())
+    assert ocr.read_text_fast(object()) is None
+    assert ocr.read_words_fast(object()) == []      # 不吞异常的入口另有约定
+
+
+def test_read_text_fast_without_chain_is_none(monkeypatch):
+    """后端不是多级链（没有 rapid 一级）→ None：整条判据退化成老路径。"""
+
+    class _Backend(object):
+        rapid = None
+
+    monkeypatch.setattr(ocr, "_backend", _Backend())
+    assert ocr.read_text_fast(object()) is None
