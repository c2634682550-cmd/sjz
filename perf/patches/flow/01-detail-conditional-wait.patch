+    def _wait_detail_ready(self, screen, cap):
+        """等详情面板真的渲染出来（读到面板编号即认为已渲染）。
+
+        固定睡 0.55s 是最贵的「不确定等待」：真机上详情页通常 100ms 内就画好，
+        剩下的 450ms 全是白等，而且还要在「来不及」判定上再等一次。
+        读出编号就立刻走；读不到就一直等到 cap（与老行为等价）。
+        """
+        t0 = time.perf_counter()
+        while time.perf_counter() - t0 < cap:
+            if self._stop.is_set():
+                raise Aborted("用户停止")
+            if self._read_serial(screen):
+                return True
+            time.sleep(0.03)
+        return False
+
